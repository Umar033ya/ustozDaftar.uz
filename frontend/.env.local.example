NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-side only — must NOT be prefixed with NEXT_PUBLIC_ or it will be
# exposed to the browser. Used by app/api/extract-students/route.js.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Firebase Admin SDK (server-side only) verifies the Firebase ID token that
# every /api/extract-students request must carry. Verifying an ID token only
# needs the project id — Google's public signing keys are fetched over HTTPS —
# so no service-account private key is required here.
#
# Optional: leave unset to reuse NEXT_PUBLIC_FIREBASE_PROJECT_ID above.
FIREBASE_PROJECT_ID=your_project_id

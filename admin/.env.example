# -----------------------------------------------------------------------------
# UstozDaftar.uz Admin - environment variables
#
# Copy this file to `.env.local` and fill in the server-only values. Never commit
# `.env.local`.
#
# The NEXT_PUBLIC_* values below are the SAME public Firebase web-app config used
# by the existing frontend (frontend/.env.local) - they were copied from it, so
# both apps share the exact same Firebase project. They are safe to expose to the
# browser (the Firebase Web SDK ships this config to every client). The FIREBASE_*
# values are server-only secrets and must never be prefixed with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Public Firebase web app config (client-side; identical to frontend/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDnALUNJx3KVpdsWZKC1cAT5k5gYuSDn28
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ustozdaftar-uz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ustozdaftar-uz
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ustozdaftar-uz.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=483878343821
NEXT_PUBLIC_FIREBASE_APP_ID=1:483878343821:web:e309ee9abb8bf302edfec4
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/User/Documents/ustozdaftar-uz-firebase-adminsdk-fbsvc-4fb933b298.json
FIREBASE_ADMIN_PROJECT_ID=ustozdaftar-uz
ADMIN_SESSION_MAX_AGE_SECONDS=604800
# -- Server-side only ---------------------------------------------------------
# Used by the Firebase Admin SDK (session cookies + Firestore admin access).
# Provide ONE of the two options below.

# Option A: the full service-account JSON as a single-line string
# (Firebase Console -> Project settings -> Service accounts -> Generate new private key)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ustozdaftar-uz",...}

# Option B: path to a service-account JSON file on the server
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json

# Fallback project id for the Admin SDK (optional; defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID)
# FIREBASE_ADMIN_PROJECT_ID=ustozdaftar-uz

# Session cookie lifetime in seconds (default: 7 days = 604800)
# ADMIN_SESSION_MAX_AGE_SECONDS=604800